# Copy this file to `.env` and fill in real values.
# The database must be a PostgreSQL instance reachable from your machine.

DATABASE_URL="postgresql://postgres:your_password@localhost:5432/resourcehub?schema=public"

# Better Auth (email/password sessions). Generate a strong secret, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"